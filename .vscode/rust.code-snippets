  "添字集合": {
    "scope": "rust",
    "prefix": "添字集合",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// 0..n の添字を O(1) で挿入・削除・存在判定でき、さらに O(1) で一様ランダムに",
      "/// 1個取り出せる集合。焼きなましの「まだ使っていない要素」管理などに使う。",
      "/// （HashSet と違い、要素の列挙順は挿入・削除の履歴に依存する）",
      "struct 添字集合 {",
      "    要素: Vec<usize>,",
      "    /// 位置[v] = 要素 の中での v の添字。含まれないときは usize::MAX。",
      "    位置: Vec<usize>,",
      "}",
      "impl 添字集合 {",
      "    /// 空集合（扱える値は 0..n）。",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            要素: Vec::with_capacity(n),",
      "            位置: vec![usize::MAX; n],",
      "        }",
      "    }",
      "    /// 0..n を全部含んだ状態で作る。",
      "    fn 全体(n: usize) -> Self {",
      "        Self {",
      "            要素: (0..n).collect(),",
      "            位置: (0..n).collect(),",
      "        }",
      "    }",
      "    fn 含む(&self, v: usize) -> bool {",
      "        self.位置[v] != usize::MAX",
      "    }",
      "    /// 追加できたら true（既にあれば false）。",
      "    fn 挿入(&mut self, v: usize) -> bool {",
      "        if self.含む(v) {",
      "            return false;",
      "        }",
      "        self.位置[v] = self.要素.len();",
      "        self.要素.push(v);",
      "        true",
      "    }",
      "    /// 削除できたら true（無ければ false）。末尾要素を穴に詰めるので O(1)。",
      "    fn 削除(&mut self, v: usize) -> bool {",
      "        if !self.含む(v) {",
      "            return false;",
      "        }",
      "        let i = self.位置[v];",
      "        let 末尾 = *self.要素.last().unwrap();",
      "        self.要素[i] = 末尾;",
      "        self.位置[末尾] = i;",
      "        self.要素.pop();",
      "        self.位置[v] = usize::MAX;",
      "        true",
      "    }",
      "    /// i 番目の要素（0 <= i < len）。ランダム抽出は `集合.取得(rng.未満(集合.len()))`。",
      "    fn 取得(&self, i: usize) -> usize {",
      "        self.要素[i]",
      "    }",
      "    fn len(&self) -> usize {",
      "        self.要素.len()",
      "    }",
      "    fn is_empty(&self) -> bool {",
      "        self.要素.is_empty()",
      "    }",
      "    fn iter(&self) -> std::slice::Iter<'_, usize> {",
      "        self.要素.iter()",
      "    }",
      "    fn clear(&mut self) {",
      "        for &v in &self.要素 {",
      "            self.位置[v] = usize::MAX;",
      "        }",
      "        self.要素.clear();",
      "    }",
      "}"
    ]
  },
  "焼きなまし": {
    "scope": "rust",
    "prefix": "焼きなまし",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// プログラム開始からの経過秒数。初回呼び出しの時刻が基準になるので、",
      "/// main の先頭で一度 `get_time();` を呼んで基準を確定させる。",
      "pub fn get_time() -> f64 {",
      "    use std::sync::OnceLock;",
      "    use std::time::Instant;",
      "    static STIME: OnceLock<Instant> = OnceLock::new();",
      "    STIME.get_or_init(Instant::now).elapsed().as_secs_f64()",
      "}",
      "/// 制限時間に対する進捗 [0.0, 1.0]。温度スケジュールなどに使う。",
      "pub fn 進捗(制限時間: f64) -> f64 {",
      "    (get_time() / 制限時間).min(1.0)",
      "}",
      "/// xorshift64 ベースの軽量 RNG。rand クレートより速く、seed 固定で再現可能。",
      "pub struct 乱数 {",
      "    状態: u64,",
      "}",
      "impl 乱数 {",
      "    pub fn new(seed: u64) -> Self {",
      "        let mut x = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);",
      "        x = (x ^ (x >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);",
      "        x = (x ^ (x >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);",
      "        Self {",
      "            状態: (x ^ (x >> 31)) | 1,",
      "        }",
      "    }",
      "    pub fn next_u64(&mut self) -> u64 {",
      "        let mut x = self.状態;",
      "        x ^= x << 13;",
      "        x ^= x >> 7;",
      "        x ^= x << 17;",
      "        self.状態 = x;",
      "        x",
      "    }",
      "    /// [0, 未満) の一様乱数。乗算によるレンジ縮約（剰余より速い）。",
      "    pub fn 未満(&mut self, 未満: usize) -> usize {",
      "        debug_assert!(未満 > 0);",
      "        ((self.next_u64() as u128 * 未満 as u128) >> 64) as usize",
      "    }",
      "    /// [下限, 上限) の一様乱数。",
      "    pub fn 範囲(&mut self, 下限: usize, 上限: usize) -> usize {",
      "        debug_assert!(下限 < 上限);",
      "        下限 + self.未満(上限 - 下限)",
      "    }",
      "    /// [下限, 上限) の一様乱数（符号付き）。",
      "    pub fn 範囲i64(&mut self, 下限: i64, 上限: i64) -> i64 {",
      "        debug_assert!(下限 < 上限);",
      "        下限 + self.未満((上限 - 下限) as usize) as i64",
      "    }",
      "    /// [0.0, 1.0) の一様乱数。",
      "    pub fn f64(&mut self) -> f64 {",
      "        (self.next_u64() >> 11) as f64 * (1.0 / (1u64 << 53) as f64)",
      "    }",
      "    /// 確率 p で true。",
      "    pub fn 確率(&mut self, p: f64) -> bool {",
      "        self.f64() < p",
      "    }",
      "    /// スライスから一様に1要素選ぶ。",
      "    pub fn 選ぶ<'a, T>(&mut self, 列: &'a [T]) -> &'a T {",
      "        &列[self.未満(列.len())]",
      "    }",
      "    /// Fisher-Yates シャッフル。",
      "    pub fn シャッフル<T>(&mut self, 列: &mut [T]) {",
      "        for i in (1..列.len()).rev() {",
      "            列.swap(i, self.未満(i + 1));",
      "        }",
      "    }",
      "}",
      "/// 焼きなまし法の温度管理と遷移採否。**スコア最大化**が前提",
      "/// （最小化問題ならスコアの符号を反転して渡す）。",
      "/// ```ignore",
      "/// get_time(); // 計測開始",
      "/// let mut rng = 乱数::new(42);",
      "/// let mut sa = 焼きなまし::new(2000.0, 10.0, 1.9);",
      "/// let (mut 最良, mut 最良スコア) = (現在.clone(), 現在スコア);",
      "/// while !sa.打ち切るか() {",
      "///     let 近傍 = 近傍生成(&mut rng, &現在);",
      "///     let 差分 = 差分評価(&現在, &近傍);",
      "///     if sa.採用するか(差分, &mut rng) {",
      "///         適用(&mut 現在, 近傍);",
      "///         現在スコア += 差分;",
      "///         if 現在スコア > 最良スコア {",
      "///             最良スコア = 現在スコア;",
      "///             最良 = 現在.clone();",
      "///         }",
      "///     }",
      "/// }",
      "/// eprintln!(\"iter={} score={}\", sa.反復回数(), 最良スコア);",
      "/// ```",
      "struct 焼きなまし {",
      "    開始温度: f64,",
      "    終了温度: f64,",
      "    制限時間: f64,",
      "    温度: f64,",
      "    /// 時刻を確認する間隔（get_time が重いので毎回は呼ばない）",
      "    確認間隔: u64,",
      "    反復回数: u64,",
      "}",
      "impl 焼きなまし {",
      "    fn new(開始温度: f64, 終了温度: f64, 制限時間: f64) -> Self {",
      "        debug_assert!(開始温度 > 0.0 && 終了温度 > 0.0);",
      "        Self {",
      "            開始温度,",
      "            終了温度,",
      "            制限時間,",
      "            温度: 開始温度,",
      "            確認間隔: 256,",
      "            反復回数: 0,",
      "        }",
      "    }",
      "    fn 確認間隔設定(mut self, 確認間隔: u64) -> Self {",
      "        self.確認間隔 = 確認間隔.max(1);",
      "        self",
      "    }",
      "    /// 進捗 [0.0, 1.0] に応じて温度を指数的に下げる。",
      "    fn 温度更新(&mut self, 進捗: f64) {",
      "        self.温度 = self.開始温度 * (self.終了温度 / self.開始温度).powf(進捗);",
      "    }",
      "    /// ループ先頭で呼ぶ。確認間隔ごとに時刻を見て温度を更新し、",
      "    /// 制限時間を超えていたら true（＝打ち切り）を返す。",
      "    fn 打ち切るか(&mut self) -> bool {",
      "        self.反復回数 += 1;",
      "        if self.反復回数 % self.確認間隔 != 0 {",
      "            return false;",
      "        }",
      "        let 経過 = get_time();",
      "        if 経過 >= self.制限時間 {",
      "            return true;",
      "        }",
      "        self.温度更新(経過 / self.制限時間);",
      "        false",
      "    }",
      "    /// スコア差（新 - 旧、正なら改善）に対する遷移採否。",
      "    fn 採用するか(&self, スコア差: f64, rng: &mut 乱数) -> bool {",
      "        if スコア差 >= 0.0 {",
      "            return true;",
      "        }",
      "        let 指数 = スコア差 / self.温度;",
      "        指数 > -20.0 && rng.f64() < 指数.exp()",
      "    }",
      "    fn 反復回数(&self) -> u64 {",
      "        self.反復回数",
      "    }",
      "}"
    ]
  },
  "素数関連": {
    "scope": "rust",
    "prefix": "素数関連",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "#[derive(Default)]",
      "pub struct 素因数分解器 {",
      "    最小素因数テーブル: Vec<usize>,",
      "    素数リスト: Vec<usize>,",
      "}",
      "impl 素因数分解器 {",
      "    pub fn new() -> Self {",
      "        let 最大値 = 5 * 10u32.pow(7) as usize;",
      "        let mut 最小素因数テーブル = vec![0; 最大値 + 1];",
      "        let mut 素数リスト = Vec::new();",
      "        for i in 2..=最大値 {",
      "            if 最小素因数テーブル[i] == 0 {",
      "                最小素因数テーブル[i] = i;",
      "                素数リスト.push(i);",
      "            }",
      "            for &素因数 in &素数リスト {",
      "                let 合成数 = i * 素因数;",
      "                if 合成数 > 最大値 {",
      "                    break;",
      "                }",
      "                最小素因数テーブル[合成数] = 素因数;",
      "                if 素因数 >= 最小素因数テーブル[i] {",
      "                    break;",
      "                }",
      "            }",
      "        }",
      "        Self {",
      "            最小素因数テーブル,",
      "            素数リスト,",
      "        }",
      "    }",
      "    pub fn 素因数分解(&self, 自然数: &usize) -> FxHashMap<usize, usize> {",
      "        let mut 結果 = FxHashMap::default();",
      "        let mut n = *自然数;",
      "        while n > 1 {",
      "            let 因数 = self.最小素因数テーブル[n];",
      "            let mut 指数 = 0;",
      "            while n % 因数 == 0 {",
      "                n /= 因数;",
      "                指数 += 1;",
      "            }",
      "            if 指数 > 0 {",
      "                結果.insert(因数, 指数);",
      "            }",
      "        }",
      "        結果",
      "    }",
      "}"
    ]
  },
