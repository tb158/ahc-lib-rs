  "巻き戻しUnionFind": {
    "scope": "rust",
    "prefix": "巻き戻しUnionFind",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// 巻き戻せる Union-Find（union by size、経路圧縮なし）。",
      "/// 焼きなましで「連結性を試しに壊して、ダメなら戻す」用途に使う。",
      "/// 経路圧縮しないぶん `根` は O(log n)。巻き戻しが不要なら普通の UF や",
      "/// ac-library-rs の `Dsu` の方が速い。",
      "struct 巻き戻しUF {",
      "    /// 根なら -(サイズ)、そうでなければ親の添字",
      "    親: Vec<i32>,",
      "    /// (統合された側の子, その直前の値) の履歴",
      "    履歴: Vec<(usize, i32)>,",
      "}",
      "impl 巻き戻しUF {",
      "    fn new(n: usize) -> Self {",
      "        Self {",
      "            親: vec![-1; n],",
      "            履歴: Vec::new(),",
      "        }",
      "    }",
      "    fn 根(&self, mut v: usize) -> usize {",
      "        while self.親[v] >= 0 {",
      "            v = self.親[v] as usize;",
      "        }",
      "        v",
      "    }",
      "    fn 同じ(&self, u: usize, v: usize) -> bool {",
      "        self.根(u) == self.根(v)",
      "    }",
      "    fn 大きさ(&self, v: usize) -> usize {",
      "        let r = self.根(v);",
      "        (-self.親[r]) as usize",
      "    }",
      "    /// 統合。もともと別の集合だったら true。",
      "    /// 失敗した場合も巻き戻し履歴には積む（`巻き戻し` の回数を数えやすくするため）。",
      "    fn 統合(&mut self, u: usize, v: usize) -> bool {",
      "        let (mut ru, mut rv) = (self.根(u), self.根(v));",
      "        if ru == rv {",
      "            self.履歴.push((ru, self.親[ru]));",
      "            return false;",
      "        }",
      "        if self.親[ru] > self.親[rv] {",
      "            std::mem::swap(&mut ru, &mut rv);",
      "        }",
      "        self.履歴.push((rv, self.親[rv]));",
      "        self.親[ru] += self.親[rv];",
      "        self.親[rv] = ru as i32;",
      "        true",
      "    }",
      "    /// 直前の `統合` を1回分取り消す。",
      "    fn 巻き戻し(&mut self) -> bool {",
      "        let (v, 元の値) = match self.履歴.pop() {",
      "            Some(x) => x,",
      "            None => return false,",
      "        };",
      "        let 親 = self.親[v];",
      "        if 親 >= 0 {",
      "            self.親[親 as usize] -= 元の値;",
      "        }",
      "        self.親[v] = 元の値;",
      "        true",
      "    }",
      "    /// 現在の履歴長。`巻き戻し状態(点)` に渡すと、その時点まで一気に戻せる。",
      "    fn 現在状態(&self) -> usize {",
      "        self.履歴.len()",
      "    }",
      "    fn 巻き戻し状態(&mut self, 点: usize) {",
      "        while self.履歴.len() > 点 {",
      "            self.巻き戻し();",
      "        }",
      "    }",
      "}"
    ]
  },
