{
  "Zobristハッシュ": {
    "scope": "rust",
    "prefix": "Zobristハッシュ",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// xorshift64 ベースの軽量 RNG。rand クレートより速く、seed 固定で再現可能。",
      "pub struct 乱数 {",
      "    状態: u64,",
      "}",
      "impl 乱数 {",
      "    pub fn new(seed: u64) -> Self {",
      "        let mut x = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);",
      "        x = (x ^ (x >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);",
      "        x = (x ^ (x >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);",
      "        Self {",
      "            状態: (x ^ (x >> 31)) | 1,",
      "        }",
      "    }",
      "    pub fn next_u64(&mut self) -> u64 {",
      "        let mut x = self.状態;",
      "        x ^= x << 13;",
      "        x ^= x >> 7;",
      "        x ^= x << 17;",
      "        self.状態 = x;",
      "        x",
      "    }",
      "    /// [0, 未満) の一様乱数。乗算によるレンジ縮約（剰余より速い）。",
      "    pub fn 未満(&mut self, 未満: usize) -> usize {",
      "        debug_assert!(未満 > 0);",
      "        ((self.next_u64() as u128 * 未満 as u128) >> 64) as usize",
      "    }",
      "    /// [下限, 上限) の一様乱数。",
      "    pub fn 範囲(&mut self, 下限: usize, 上限: usize) -> usize {",
      "        debug_assert!(下限 < 上限);",
      "        下限 + self.未満(上限 - 下限)",
      "    }",
      "    /// [下限, 上限) の一様乱数（符号付き）。",
      "    pub fn 範囲i64(&mut self, 下限: i64, 上限: i64) -> i64 {",
      "        debug_assert!(下限 < 上限);",
      "        下限 + self.未満((上限 - 下限) as usize) as i64",
      "    }",
      "    /// [0.0, 1.0) の一様乱数。",
      "    pub fn f64(&mut self) -> f64 {",
      "        (self.next_u64() >> 11) as f64 * (1.0 / (1u64 << 53) as f64)",
      "    }",
      "    /// 確率 p で true。",
      "    pub fn 確率(&mut self, p: f64) -> bool {",
      "        self.f64() < p",
      "    }",
      "    /// スライスから一様に1要素選ぶ。",
      "    pub fn 選ぶ<'a, T>(&mut self, 列: &'a [T]) -> &'a T {",
      "        &列[self.未満(列.len())]",
      "    }",
      "    /// Fisher-Yates シャッフル。",
      "    pub fn シャッフル<T>(&mut self, 列: &mut [T]) {",
      "        for i in (1..列.len()).rev() {",
      "            列.swap(i, self.未満(i + 1));",
      "        }",
      "    }",
      "}",
      "/// Zobrist ハッシュ。「位置 × 値」ごとの乱数を XOR で足し引きして、",
      "/// 状態の指紋を差分 O(1) で更新する。ビームサーチの重複除去や",
      "/// 焼きなましのメモ化に使う。",
      "struct Zobrist {",
      "    表: Vec<u64>,",
      "    値数: usize,",
      "}",
      "impl Zobrist {",
      "    fn new(位置数: usize, 値数: usize, seed: u64) -> Self {",
      "        let mut rng = 乱数::new(seed);",
      "        Self {",
      "            表: (0..位置数 * 値数).map(|_| rng.next_u64()).collect(),",
      "            値数,",
      "        }",
      "    }",
      "    fn 鍵(&self, 位置: usize, 値: usize) -> u64 {",
      "        self.表[位置 * self.値数 + 値]",
      "    }",
      "    /// 位置 の値を 値 に「置く／取り除く」。同じ引数で2回呼ぶと元に戻る。",
      "    fn 切替(&self, ハッシュ: &mut u64, 位置: usize, 値: usize) {",
      "        *ハッシュ ^= self.鍵(位置, 値);",
      "    }",
      "    /// 位置 の値を 旧値 から 新値 に変える。",
      "    fn 更新(&self, ハッシュ: &mut u64, 位置: usize, 旧値: usize, 新値: usize) {",
      "        *ハッシュ ^= self.鍵(位置, 旧値) ^ self.鍵(位置, 新値);",
      "    }",
      "    /// 状態全体からハッシュを作り直す（初期化・検証用）。",
      "    fn 全体(&self, 状態: &[usize]) -> u64 {",
      "        状態",
      "            .iter()",
      "            .enumerate()",
      "            .fold(0, |h, (位置, &値)| h ^ self.鍵(位置, 値))",
      "    }",
      "}"
    ]
  },
  "dfs": {
    "scope": "rust",
    "prefix": "dfs",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "pub fn dfs(グラフ: &[Vec<usize>], 到達: &mut [bool], 点: usize) {",
      "    到達[点] = true;",
      "    for &隣接点 in &グラフ[点] {",
      "        if 到達[隣接点] {",
      "            continue;",
      "        }",
      "        dfs(グラフ, 到達, 隣接点);",
      "    }",
      "}"
    ]
  },
  "グリッドの境界頂点": {
    "scope": "rust",
    "prefix": "グリッドの境界頂点",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// グリッド内で特定の要素（target）が含まれる最小の長方形範囲（上下左右の境界インデックス）を返す",
      "/// 返り値: Option<(h_min, h_max, w_min, w_max)>",
      "fn グリッドの境界頂点<T: PartialEq + Copy>(",
      "    グリッド: &[Vec<T>],",
      "    target: T,",
      ") -> Option<(usize, usize, usize, usize)> {",
      "    let h_min = グリッド.iter().position(|行| 行.contains(&target))?;",
      "    let h_max = グリッド.iter().rposition(|行| 行.contains(&target))?;",
      "    let w_min = グリッド",
      "        .iter()",
      "        .filter_map(|行| 行.iter().position(|&マス| マス == target))",
      "        .min()?;",
      "    let w_max = グリッド",
      "        .iter()",
      "        .filter_map(|行| 行.iter().rposition(|&c| c == target))",
      "        .max()?;",
      "    Some((h_min, h_max, w_min, w_max))",
      "}"
    ]
  },
