    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "fn 転倒数算出(順列_a: &[usize], 順列_b: &[usize]) -> usize {",
      "    let mut bの逆置換 = vec![0; 順列_a.len()];",
      "    for (i, &値) in 順列_b.iter().enumerate() {",
      "        bの逆置換[値] = i;",
      "    }",
      "    順列_a",
      "        .iter()",
      "        .map(|&値| bの逆置換[値])",
      "        .tuple_combinations()",
      "        .filter(|(前, 後)| 前 > 後)",
      "        .count()",
      "}"
    ]
  },
  "連長圧縮": {
    "scope": "rust",
    "prefix": "連長圧縮",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Clone, Copy, Debug, Default)]",
      "struct ブロック<T> {",
      "    値: T,",
      "    長さ: usize,",
      "}",
      "fn 連長圧縮<T: Eq + Clone>(a: &[T]) -> Vec<ブロック<T>> {",
      "    let mut 結果 = a",
      "        .iter()",
      "        .map(|item| ブロック {",
      "            値: item.clone(),",
      "            長さ: 1,",
      "        })",
      "        .collect::<Vec<_>>();",
      "    結果.dedup_by(|a, b| {",
      "        a.値 == b.値 && {",
      "            b.長さ += a.長さ;",
      "            true",
      "        }",
      "    });",
      "    結果",
      "}"
    ]
  },
  "部分列突合用idx遷移": {
    "scope": "rust",
    "prefix": "部分列突合用idx遷移",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// 部分列判定用の遷移配列",
      "/// 文字列（0~25の usize に変換済みのスライス）を受け取り、",
      "/// next[l][a] = l 文字目以降で最初に文字 a が出現する位置 + 1 (存在しなければ None) を返す。",
      "pub fn 部分列突合用idx遷移(文字列: &[usize]) -> Vec<Vec<Option<usize>>> {",
      "    let mut next = vec![vec![None; 26]; 文字列.len() + 1];",
      "    for (idx, &文字) in 文字列.iter().enumerate().rev() {",
      "        for j in 0..26 {",
      "            next[idx][j] = next[idx + 1][j];",
      "        }",
      "        next[idx][文字] = Some(idx + 1);",
      "    }",
      "    next",
      "}"
    ]
  }
