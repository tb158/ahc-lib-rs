  "二次元いもす": {
    "scope": "rust",
    "prefix": "二次元いもす",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// 二次元いもす法。矩形加算を O(1) で受け付け、最後に一度だけ展開する。",
      "struct 二次元いもす {",
      "    d: Vec<Vec<i64>>,",
      "    h: usize,",
      "    w: usize,",
      "}",
      "impl 二次元いもす {",
      "    fn new(h: usize, w: usize) -> Self {",
      "        Self {",
      "            d: vec![vec![0i64; w + 1]; h + 1],",
      "            h,",
      "            w,",
      "        }",
      "    }",
      "    /// [i1, i2) x [j1, j2) に 値 を加算する。",
      "    fn 加算(&mut self, i1: usize, j1: usize, i2: usize, j2: usize, 値: i64) {",
      "        debug_assert!(i1 <= i2 && i2 <= self.h && j1 <= j2 && j2 <= self.w);",
      "        self.d[i1][j1] += 値;",
      "        self.d[i1][j2] -= 値;",
      "        self.d[i2][j1] -= 値;",
      "        self.d[i2][j2] += 値;",
      "    }",
      "    /// 累積を取って h x w のグリッドにする。",
      "    fn 構築(&self) -> Vec<Vec<i64>> {",
      "        let mut a = self.d.clone();",
      "        for 行 in a.iter_mut() {",
      "            for j in 1..=self.w {",
      "                行[j] += 行[j - 1];",
      "            }",
      "        }",
      "        for j in 0..=self.w {",
      "            for i in 1..=self.h {",
      "                a[i][j] += a[i - 1][j];",
      "            }",
      "        }",
      "        a.truncate(self.h);",
      "        for 行 in a.iter_mut() {",
      "            行.truncate(self.w);",
      "        }",
      "        a",
      "    }",
      "}"
    ]
  },
  "二次元累積和": {
    "scope": "rust",
    "prefix": "二次元累積和",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// 二次元累積和。矩形 [i1, i2) x [j1, j2) の和を O(1) で返す。",
      "/// 盤面の評価値（塗った面積・重みの合計など）を毎回数え直さないために使う。",
      "struct 二次元累積和 {",
      "    /// s[i][j] = 左上 (0,0) から (i,j) を含まない範囲の和",
      "    s: Vec<Vec<i64>>,",
      "}",
      "impl 二次元累積和 {",
      "    fn new(a: &[Vec<i64>]) -> Self {",
      "        let h = a.len();",
      "        let w = if h == 0 { 0 } else { a[0].len() };",
      "        let mut s = vec![vec![0i64; w + 1]; h + 1];",
      "        for i in 0..h {",
      "            for j in 0..w {",
      "                s[i + 1][j + 1] = s[i][j + 1] + s[i + 1][j] - s[i][j] + a[i][j];",
      "            }",
      "        }",
      "        Self { s }",
      "    }",
      "    /// [i1, i2) x [j1, j2) の和。",
      "    fn 和(&self, i1: usize, j1: usize, i2: usize, j2: usize) -> i64 {",
      "        debug_assert!(i1 <= i2 && j1 <= j2);",
      "        self.s[i2][j2] - self.s[i1][j2] - self.s[i2][j1] + self.s[i1][j1]",
      "    }",
      "}"
    ]
  },
  "履歴木": {
    "scope": "rust",
    "prefix": "履歴木",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// ビームサーチ用の操作履歴（親リンクだけを持つ木）。",
      "/// 各ノードに解全体を持たせる代わりに「直前の操作＋親ID」だけを積み、",
      "/// 最後に葉から根まで遡って操作列を復元する。",
      "struct 履歴木<T> {",
      "    ログ: Vec<(T, Option<usize>)>,",
      "}",
      "impl<T: Clone> 履歴木<T> {",
      "    fn new() -> Self {",
      "        Self { ログ: Vec::new() }",
      "    }",
      "    fn with_capacity(容量: usize) -> Self {",
      "        Self {",
      "            ログ: Vec::with_capacity(容量),",
      "        }",
      "    }",
      "    /// 操作を追加して、そのノードIDを返す。根の直下なら 親 = None。",
      "    fn 追加(&mut self, 操作: T, 親: Option<usize>) -> usize {",
      "        self.ログ.push((操作, 親));",
      "        self.ログ.len() - 1",
      "    }",
      "    /// ノードIDから根までの操作列を（根 → 葉の順で）復元する。",
      "    fn 復元(&self, id: Option<usize>) -> Vec<T> {",
      "        let mut 結果 = Vec::new();",
      "        let mut 現在 = id;",
      "        while let Some(i) = 現在 {",
      "            結果.push(self.ログ[i].0.clone());",
      "            現在 = self.ログ[i].1;",
      "        }",
      "        結果.reverse();",
      "        結果",
      "    }",
      "    /// 根からの深さ（操作回数）。",
      "    fn 深さ(&self, id: Option<usize>) -> usize {",
      "        let mut 深さ = 0;",
      "        let mut 現在 = id;",
      "        while let Some(i) = 現在 {",
      "            深さ += 1;",
      "            現在 = self.ログ[i].1;",
      "        }",
      "        深さ",
      "    }",
      "    fn len(&self) -> usize {",
      "        self.ログ.len()",
      "    }",
      "    fn is_empty(&self) -> bool {",
      "        self.ログ.is_empty()",
      "    }",
      "}",
      "impl<T: Clone> Default for 履歴木<T> {",
      "    fn default() -> Self {",
      "        Self::new()",
      "    }",
      "}"
    ]
  },
