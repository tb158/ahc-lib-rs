    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// ビームの1候補。スコア最大化前提で、`sort_unstable` すると降順（良い順）に並ぶ。",
      "#[derive(Clone, Copy, Debug, PartialEq)]",
      "struct 候補<S> {",
      "    スコア: i64,",
      "    状態: S,",
      "    /// 履歴木のノードID",
      "    履歴: Option<usize>,",
      "}",
      "impl<S: PartialEq> Eq for 候補<S> {}",
      "impl<S: PartialEq> Ord for 候補<S> {",
      "    fn cmp(&self, other: &Self) -> std::cmp::Ordering {",
      "        other.スコア.cmp(&self.スコア)",
      "    }",
      "}",
      "impl<S: PartialEq> PartialOrd for 候補<S> {",
      "    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {",
      "        Some(self.cmp(other))",
      "    }",
      "}"
    ]
  },
  "ビーム幅選抜": {
    "scope": "rust",
    "prefix": "ビーム幅選抜",
    "body": [
      "// https://github.com/tb158/ahc-lib-rs",
      "/// ビームの1候補。スコア最大化前提で、`sort_unstable` すると降順（良い順）に並ぶ。",
      "#[derive(Clone, Copy, Debug, PartialEq)]",
      "struct 候補<S> {",
      "    スコア: i64,",
      "    状態: S,",
      "    /// 履歴木のノードID",
      "    履歴: Option<usize>,",
      "}",
      "impl<S: PartialEq> Eq for 候補<S> {}",
      "impl<S: PartialEq> Ord for 候補<S> {",
      "    fn cmp(&self, other: &Self) -> std::cmp::Ordering {",
      "        other.スコア.cmp(&self.スコア)",
      "    }",
      "}",
      "impl<S: PartialEq> PartialOrd for 候補<S> {",
      "    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {",
      "        Some(self.cmp(other))",
      "    }",
      "}",
      "/// 候補列からハッシュ重複を除きつつ上位 幅 件を残す。",
      "/// `ハッシュ` は Zobrist などで作った状態の指紋。",
      "fn 選抜<S: PartialEq + Copy>(",
      "    候補列: &mut [(候補<S>, u64)],",
      "    幅: usize,",
      "    使用済み: &mut rustc_hash::FxHashSet<u64>,",
      ") -> Vec<候補<S>> {",
      "    候補列.sort_unstable_by(|a, b| a.0.cmp(&b.0));",
      "    使用済み.clear();",
      "    let mut 結果 = Vec::with_capacity(幅);",
      "    for (c, h) in 候補列.iter() {",
      "        if 結果.len() >= 幅 {",
      "            break;",
      "        }",
      "        if 使用済み.insert(*h) {",
      "            結果.push(*c);",
      "        }",
      "    }",
      "    結果",
      "}"
    ]
  },
